# PBK Command Center — environment variable reference
#
# Copy this file to .env.local for local development.
# .env.local is gitignored and will never be committed.
#
# For Netlify production, set these in:
#   Netlify UI → pbkcenter → Site configuration → Environment variables
#
# Variables marked REQUIRED must be set or the feature will be broken/disabled.
# Variables marked OPTIONAL have safe defaults but can be tuned.

# ---------------------------------------------------------------------------
# BRIDGE CONNECTION
# Used by: Vite dev proxy, pbk-bridge-proxy function, public-ava-chat function
# ---------------------------------------------------------------------------

# Primary bridge URL (used by Netlify functions in production)
# REQUIRED for pbk-bridge-proxy and public-ava-chat to reach the backend.
# Without this, functions fall back to https://pbk-openclaw-bridge.onrender.com
# which cold-starts after 15 minutes of inactivity and will cause 504s.
PBK_BRIDGE_URL=https://your-bridge-host.example.com

# Local dev override — points Vite's dev proxy to your local bridge instance.
# Falls back to PBK_BRIDGE_URL, then http://127.0.0.1:8788 (Netlify Dev default).
PBK_DEV_BRIDGE_URL=http://127.0.0.1:8788

# OPTIONAL: Mapbox public access token for the Prospecting parcel map.
# Vite exposes this value in the browser. Use only a public token.
VITE_MAPBOX_PUBLIC_TOKEN=

# Alias accepted by functions (same as PBK_BRIDGE_URL — set either, not both)
# PBK_PUBLIC_BRIDGE_URL=

# Dashboard identity reported by the Render bridge (non-secret).
PBK_NETLIFY_URL=https://pbkcenter.netlify.app
PBK_NETLIFY_SITE_ID=87711eb9-2a9f-40b4-92c6-0f8075151ff0

# ---------------------------------------------------------------------------
# BRIDGE AUTH
# Used by: Vite dev proxy Authorization header
# ---------------------------------------------------------------------------

# API key sent as Authorization: Bearer <key> in dev proxy requests.
# Use any of these aliases — first one found wins.
PBK_DEV_BRIDGE_API_KEY=
# PBK_BRIDGE_API_KEY=
# PBK_OPENCLAW_API_KEY=
# OPENCLAW_API_KEY=

# Bridge only: separate founder secret for recording retention approvals and grant signing.
# Never reuse PBK_BRIDGE_API_KEY or forward this credential through a browser or proxy.
PBK_RECORDING_RETENTION_FOUNDER_KEY=

# Bridge only. Use a HighLevel sub-account token with contacts.readonly.
# Map exact PBK seller lead IDs to staff-verified contacts in this sub-account.
PBK_HIGHLEVEL_READ_TOKEN=
PBK_HIGHLEVEL_LOCATION_ID=
PBK_HIGHLEVEL_LEAD_CONTACT_MAP={}

# Bridge-only Telnyx settings. Use full E.164 numbers on the bridge host.
# Set the SMS default and hold before changing the outbound voice caller ID.
# An empty SMS default preserves the shared voice/SMS fallback.
# PBK_TELNYX_SMS_FROM_NUMBER=
# PBK_TELNYX_SMS_HOLD_NUMBERS=       # Comma-separated outbound SMS senders on hold.

# ---------------------------------------------------------------------------
# LOCAL BRIDGE LIVE-CALL LLM / GEMINI + DEEPSEEK FALLBACK
# Used by: scripts/openclaw-local-server.mjs when you run the bridge locally.
# ---------------------------------------------------------------------------

# Ava live calls should use Gemini Flash for the fast structured turn decision.
# DeepSeek remains configured below as the fallback strategist lane.
PBK_LIVE_LLM_PROVIDER=gemini
PBK_STRATEGIST_PROVIDER=gemini
PBK_GEMINI_API_KEY=
# GEMINI_API_KEY=               # alias accepted by the bridge
# GOOGLE_API_KEY=                # alias accepted by the bridge
PBK_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
PBK_GEMINI_LIVE_MODEL=gemini-3.5-flash
# PBK_GEMINI_LIVE_ATTEMPT_TIMEOUT_MS=1600
# PBK_GEMINI_LIVE_RETRY_ATTEMPTS=1
# PBK_GEMINI_LIVE_RETRY_DELAY_MS=120
# PBK_TELNYX_LIVE_REPLY_STRATEGIST_TIMEOUT_MS=2500

# Production Render already has PBK_DEEPSEEK_API_KEY configured. This local
# value is only needed when local/offline bridge runs should match the
# production Ava/Rex DeepSeek fallback strategist lane.
#
# Never commit a real key. Put it in .env.local, Windows User env, or Render.
PBK_DEEPSEEK_API_KEY=
# DEEPSEEK_API_KEY=             # alias accepted by the bridge
PBK_DEEPSEEK_BASE_URL=https://api.deepseek.com
PBK_DEEPSEEK_MODEL=deepseek-v4-pro
PBK_DEEPSEEK_FALLBACK_MODEL=deepseek-v4-flash

# DeepSeek fallback/live model controls.
# PBK_DEEPSEEK_LIVE_MODEL=deepseek-v4-flash
# PBK_DEEPSEEK_LIVE_RETRY_MODELS=deepseek-v4-flash,deepseek-v4-pro
# PBK_DEEPSEEK_LIVE_ATTEMPT_TIMEOUT_MS=1400
# PBK_DEEPSEEK_LIVE_RETRY_ATTEMPTS=1
# PBK_DEEPSEEK_LIVE_RETRY_DELAY_MS=120
# PBK_DEEPSEEK_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# OPTIONAL DEEPSPEC / VLLM SPECULATIVE DECODING
# Used by: scripts/openclaw-local-server.mjs for eligible non-tool requests.
# ---------------------------------------------------------------------------

# Keep disabled until a vLLM or compatible DeepSpec endpoint is deployed.
# The endpoint should expose an OpenAI-compatible chat/completions API.
# This requires a separately hosted target model and compatible speculator;
# it cannot accelerate the hosted api.deepseek.com API from the client.
PBK_DEEPSPEC_ENABLED=false
PBK_DEEPSPEC_ENDPOINT=
PBK_DEEPSPEC_API_KEY=
PBK_DEEPSPEC_PROVIDER=vllm
PBK_DEEPSPEC_TARGET_MODEL=deepseek-v4-flash
# Set to the deployed draft checkpoint. Qwen/Gemma released checkpoints are
# only for those target families; train or attach a DeepSeek-compatible draft
# before enabling this for Ava production traffic.
PBK_DEEPSPEC_DRAFT_MODEL=
PBK_DEEPSPEC_NUM_SPECULATIVE_TOKENS=5
PBK_DEEPSPEC_TIMEOUT_MS=900
PBK_DEEPSPEC_FALLBACK_ENABLED=true

# ---------------------------------------------------------------------------
# VECTOR EMBEDDINGS
# Used by: Rex research memory and Ava episodic call memory.
# ---------------------------------------------------------------------------

# DeepSeek remains the reasoning provider above. Its public API does not expose
# a supported embeddings model, so production uses a local Hugging Face model
# with no per-request quota. A normalized 384-dimension vector is projected
# into the existing VECTOR(1536) schema while preserving cosine similarity.
PBK_EMBEDDING_PROVIDER=local_hf
PBK_LOCAL_EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
PBK_LOCAL_EMBEDDING_DTYPE=q8
# PBK_HF_CACHE_DIR=.cache/pbk-transformers

# Optional remote lane. Set PBK_EMBEDDING_PROVIDER=openai to require it, or
# auto to try it before the local model.
# PBK_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---------------------------------------------------------------------------
# LOCAL CALLBACK / NGROK (OPTIONAL, OPERATOR-ONLY)
# Used by: Render bridge -> ngrok -> local-callback-server.mjs
# ---------------------------------------------------------------------------

# Set these on Render only when you intentionally want the hosted bridge to
# trigger allowlisted local scripts through an ngrok tunnel.
# Example: PBK_LOCAL_CALLBACK_URL=https://abc123.ngrok-free.app
PBK_LOCAL_CALLBACK_URL=
PBK_LOCAL_CALLBACK_TOKEN=
# PBK_LOCAL_CALLBACK_TIMEOUT_MS=300000

# Set the same token locally before starting the sidecar:
#   $env:PBK_LOCAL_TRIGGER_TOKEN="<same secret>"
#   npm run local:callback
# Then expose it with:
#   ngrok http 33517
PBK_LOCAL_TRIGGER_TOKEN=
# PBK_LOCAL_TRIGGER_HOST=127.0.0.1
# PBK_LOCAL_TRIGGER_PORT=33517
# PBK_LOCAL_TRIGGER_ALLOWED_ACTIONS=build,test:bridge,test:mcp,test:ui-actions

# ---------------------------------------------------------------------------
# NEON DISPOSABLE EVALUATION BRANCHES (OPTIONAL, EVAL-ONLY)
# Used by: npm run neon:evaluation
# ---------------------------------------------------------------------------

# These are only for temporary Neon branches used by Ava/agent evals and risky
# database checks before production. Production bridge state remains on Render
# Postgres through PBK_DATABASE_URL in Render.
#
# Never commit a real key. Store it in .env.local, Windows User env, or CI
# secrets. Prefer a project-scoped Neon API key.
NEON_API_KEY=
NEON_PROJECT_ID=
# PBK_NEON_API_KEY=             # alias accepted by the harness
# PBK_NEON_PROJECT_ID=          # alias accepted by the harness
# PBK_NEON_EVAL_PROJECT_ID=     # eval-specific project id alias
# NEON_PARENT_BRANCH_ID=
# PBK_NEON_EVAL_TTL_HOURS=24
# PBK_NEON_EVAL_BRANCH_NAME=
# PBK_NEON_EVAL_COMMAND=npm run test:ava-eval-suite
# PBK_NEON_EVAL_INJECT_RUNTIME_DB=false

# ---------------------------------------------------------------------------
# PUBLIC AVA CHAT
# Used by: public-ava-chat Netlify function
# ---------------------------------------------------------------------------

# REQUIRED — shared secret the public Ava chat function sends to the bridge.
# Without this, every /api/public/ava-chat request returns 503.
# Set in Netlify env vars as PUBLIC_AVA_CHAT_KEY (or the alias below).
PUBLIC_AVA_CHAT_KEY=
# PBK_PUBLIC_AVA_CHAT_KEY=

# ---------------------------------------------------------------------------
# CORS (OPTIONAL)
# Used by: pbk-bridge-proxy function, public-ava-chat function
# ---------------------------------------------------------------------------

# Comma-separated list of extra allowed origins beyond the built-in defaults.
# Defaults already include pbkcommandcenter.netlify.app and localhost variants.
# Example: https://app.yourdomain.com,https://staging.yourdomain.com
PBK_ALLOWED_ORIGINS=
# PBK_CORS_ALLOWED_ORIGINS=   # alias for PBK_ALLOWED_ORIGINS

# ---------------------------------------------------------------------------
# TUNING (OPTIONAL)
# ---------------------------------------------------------------------------

# Fleet readiness policy only; these budgets do not cancel model output or speech.
# Reviewed JSON matrix keyed by chat/phone/research/provider and
# first_token/completion/speech_start/speech_completion. Missing or invalid policy
# leaves fleet qualification blocked. No completion performance budget is guessed.
PBK_AGENT_LATENCY_BUDGETS_MS=

# Approved LOCAL pilot example only, not production configuration or activation.
# Measurement only: never changes generation, request deadlines, caps or playback.
# v2 bridge qualification requires every rule; invalid v2 never falls back to v1.
PBK_AGENT_LATENCY_POLICY_V2='{"schemaVersion":2,"channels":{"chat":{"first_token":{"kind":"fixed","ms":1800},"completion":{"kind":"text","baseMs":3000,"msPerCodePoint":20}},"phone":{"first_token":{"kind":"fixed","ms":1800},"completion":{"kind":"text","baseMs":3000,"msPerCodePoint":20},"speech_start":{"kind":"fixed","ms":2500},"speech_completion":{"kind":"media","startMs":2500,"durationMultiplier":1.10,"drainMs":2000}},"research":{"completion":{"kind":"text","baseMs":120000,"msPerCodePoint":20}},"provider":{"completion":{"kind":"fixed","ms":30000}}}}'
# Remains off. Hosted/bootstrap/signing/health prerequisites and separate approval apply.
# Fixed sampling: 60000ms, max gap 90000ms, window 86400000ms, max 2000 checkpoints.
# Uses the existing bridge signing secret with domain separation; no new secret.
PBK_RUNTIME_COVERAGE_ENABLED=false
# Paged protocol requires its separately reviewed targeted migration and rollout.
# Never switches automatically or treats an unfinished baseline as coverage.
PBK_RUNTIME_CENSUS_PROTOCOL=legacy-v1

# Explicit targeted schema migration only; never read by bridge startup.
# The migration runner ignores ordinary runtime database URLs. Leave empty here.
PBK_TARGETED_MIGRATION_DATABASE_URL=
PBK_TARGETED_MIGRATION_TARGET=
PBK_TARGETED_MIGRATION_EXPECT_HOST=
PBK_TARGETED_MIGRATION_EXPECT_DATABASE=
PBK_TARGETED_MIGRATION_EXPECT_ROLE=

# Bridge proxy request timeout in milliseconds. Min 5000, max 25000. Default 20000.
# PBK_BRIDGE_PROXY_TIMEOUT_MS=20000

# Optional bridge-only Outlook receipt lookup. Connect the PBK Gmail inbox with
# Gmail read-only access in the same Composio project as Ava's Outlook sender.
# The bridge uses its existing PBK_AVA_OUTLOOK_COMPOSIO_API_KEY. Set these on
# the bridge service only. Manual receipt confirmation is available without them.
PBK_AVA_RECEIPT_GMAIL_ACCOUNT_ID=
PBK_AVA_RECEIPT_GMAIL_USER_ID=
PBK_AVA_RECEIPT_GMAIL_ADDRESS=

# Public Ava chat rate limit — max requests per IP per window. Default 60.
# PBK_PUBLIC_AVA_NETLIFY_RATE_LIMIT_MAX=60

# Public Ava chat rate limit window in milliseconds. Default 900000 (15 minutes).
# PBK_PUBLIC_AVA_NETLIFY_RATE_LIMIT_WINDOW_MS=900000
