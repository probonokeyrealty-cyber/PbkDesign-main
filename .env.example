# PBK Command Center — environment variable reference
#
# Copy this file to .env.local for local development.
# .env.local is gitignored and will never be committed.
#
# For Netlify production, set these in:
#   Netlify UI → pbkcommandcenter → Site configuration → Environment variables
#
# Variables marked REQUIRED must be set or the feature will be broken/disabled.
# Variables marked OPTIONAL have safe defaults but can be tuned.

# ---------------------------------------------------------------------------
# BRIDGE CONNECTION
# Used by: Vite dev proxy, pbk-bridge-proxy function, public-ava-chat function
# ---------------------------------------------------------------------------

# Primary bridge URL (used by Netlify functions in production)
# REQUIRED for pbk-bridge-proxy and public-ava-chat to reach the backend.
# Without this, functions fall back to https://pbk-openclaw-bridge.onrender.com
# which cold-starts after 15 minutes of inactivity and will cause 504s.
PBK_BRIDGE_URL=https://your-bridge-host.example.com

# Local dev override — points Vite's dev proxy to your local bridge instance.
# Falls back to PBK_BRIDGE_URL, then http://127.0.0.1:8788 (Netlify Dev default).
PBK_DEV_BRIDGE_URL=http://127.0.0.1:8788

# Alias accepted by functions (same as PBK_BRIDGE_URL — set either, not both)
# PBK_PUBLIC_BRIDGE_URL=

# ---------------------------------------------------------------------------
# BRIDGE AUTH
# Used by: Vite dev proxy Authorization header
# ---------------------------------------------------------------------------

# API key sent as Authorization: Bearer <key> in dev proxy requests.
# Use any of these aliases — first one found wins.
PBK_DEV_BRIDGE_API_KEY=
# PBK_BRIDGE_API_KEY=
# PBK_OPENCLAW_API_KEY=
# OPENCLAW_API_KEY=

# ---------------------------------------------------------------------------
# PUBLIC AVA CHAT
# Used by: public-ava-chat Netlify function
# ---------------------------------------------------------------------------

# REQUIRED — shared secret the public Ava chat function sends to the bridge.
# Without this, every /api/public/ava-chat request returns 503.
# Set in Netlify env vars as PUBLIC_AVA_CHAT_KEY (or the alias below).
PUBLIC_AVA_CHAT_KEY=
# PBK_PUBLIC_AVA_CHAT_KEY=

# ---------------------------------------------------------------------------
# CORS (OPTIONAL)
# Used by: pbk-bridge-proxy function, public-ava-chat function
# ---------------------------------------------------------------------------

# Comma-separated list of extra allowed origins beyond the built-in defaults.
# Defaults already include pbkcommandcenter.netlify.app and localhost variants.
# Example: https://app.yourdomain.com,https://staging.yourdomain.com
PBK_ALLOWED_ORIGINS=
# PBK_CORS_ALLOWED_ORIGINS=   # alias for PBK_ALLOWED_ORIGINS

# ---------------------------------------------------------------------------
# TUNING (OPTIONAL)
# ---------------------------------------------------------------------------

# Bridge proxy request timeout in milliseconds. Min 5000, max 25000. Default 20000.
# PBK_BRIDGE_PROXY_TIMEOUT_MS=20000

# Public Ava chat rate limit — max requests per IP per window. Default 60.
# PBK_PUBLIC_AVA_NETLIFY_RATE_LIMIT_MAX=60

# Public Ava chat rate limit window in milliseconds. Default 900000 (15 minutes).
# PBK_PUBLIC_AVA_NETLIFY_RATE_LIMIT_WINDOW_MS=900000
