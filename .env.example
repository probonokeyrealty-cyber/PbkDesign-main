# PBK Command Center — environment variable reference
#
# Copy this file to .env.local for local development.
# .env.local is gitignored and will never be committed.
#
# For Netlify production, set these in:
#   Netlify UI → pbkcommandcenter → Site configuration → Environment variables
#
# Variables marked REQUIRED must be set or the feature will be broken/disabled.
# Variables marked OPTIONAL have safe defaults but can be tuned.

# ---------------------------------------------------------------------------
# BRIDGE CONNECTION
# Used by: Vite dev proxy, pbk-bridge-proxy function, public-ava-chat function
# ---------------------------------------------------------------------------

# Primary bridge URL (used by Netlify functions in production)
# REQUIRED for pbk-bridge-proxy and public-ava-chat to reach the backend.
# Without this, functions fall back to https://pbk-openclaw-bridge.onrender.com
# which cold-starts after 15 minutes of inactivity and will cause 504s.
PBK_BRIDGE_URL=https://your-bridge-host.example.com

# Local dev override — points Vite's dev proxy to your local bridge instance.
# Falls back to PBK_BRIDGE_URL, then http://127.0.0.1:8788 (Netlify Dev default).
PBK_DEV_BRIDGE_URL=http://127.0.0.1:8788

# Alias accepted by functions (same as PBK_BRIDGE_URL — set either, not both)
# PBK_PUBLIC_BRIDGE_URL=

# ---------------------------------------------------------------------------
# BRIDGE AUTH
# Used by: Vite dev proxy Authorization header
# ---------------------------------------------------------------------------

# API key sent as Authorization: Bearer <key> in dev proxy requests.
# Use any of these aliases — first one found wins.
PBK_DEV_BRIDGE_API_KEY=
# PBK_BRIDGE_API_KEY=
# PBK_OPENCLAW_API_KEY=
# OPENCLAW_API_KEY=

# ---------------------------------------------------------------------------
# LOCAL BRIDGE LLM / DEEPSEEK
# Used by: scripts/openclaw-local-server.mjs when you run the bridge locally.
# ---------------------------------------------------------------------------

# Production Render already has PBK_DEEPSEEK_API_KEY configured. This local
# value is only needed when local/offline bridge runs should match the
# production Ava/Rex DeepSeek strategist lane.
#
# Never commit a real key. Put it in .env.local, Windows User env, or Render.
PBK_DEEPSEEK_API_KEY=
# DEEPSEEK_API_KEY=             # alias accepted by the bridge
PBK_DEEPSEEK_BASE_URL=https://api.deepseek.com
PBK_DEEPSEEK_MODEL=deepseek-v4-pro
PBK_DEEPSEEK_FALLBACK_MODEL=deepseek-v4-flash
PBK_STRATEGIST_PROVIDER=deepseek

# Fast local live-call phrasing uses the fallback/live model unless overridden.
# PBK_DEEPSEEK_LIVE_MODEL=deepseek-v4-flash
# PBK_DEEPSEEK_LIVE_RETRY_MODELS=deepseek-v4-flash,deepseek-v4-pro
# PBK_DEEPSEEK_LIVE_ATTEMPT_TIMEOUT_MS=1400
# PBK_DEEPSEEK_LIVE_RETRY_ATTEMPTS=1
# PBK_DEEPSEEK_LIVE_RETRY_DELAY_MS=120
# PBK_TELNYX_LIVE_REPLY_STRATEGIST_TIMEOUT_MS=3000
# PBK_DEEPSEEK_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# VECTOR EMBEDDINGS
# Used by: Rex research memory and Ava episodic call memory.
# ---------------------------------------------------------------------------

# DeepSeek remains the reasoning provider above. Its public API does not expose
# a supported embeddings model, so production uses a local Hugging Face model
# with no per-request quota. A normalized 384-dimension vector is projected
# into the existing VECTOR(1536) schema while preserving cosine similarity.
PBK_EMBEDDING_PROVIDER=local_hf
PBK_LOCAL_EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
PBK_LOCAL_EMBEDDING_DTYPE=q8
# PBK_HF_CACHE_DIR=.cache/pbk-transformers

# Optional remote lane. Set PBK_EMBEDDING_PROVIDER=openai to require it, or
# auto to try it before the local model.
# PBK_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---------------------------------------------------------------------------
# LOCAL CALLBACK / NGROK (OPTIONAL, OPERATOR-ONLY)
# Used by: Render bridge -> ngrok -> local-callback-server.mjs
# ---------------------------------------------------------------------------

# Set these on Render only when you intentionally want the hosted bridge to
# trigger allowlisted local scripts through an ngrok tunnel.
# Example: PBK_LOCAL_CALLBACK_URL=https://abc123.ngrok-free.app
PBK_LOCAL_CALLBACK_URL=
PBK_LOCAL_CALLBACK_TOKEN=
# PBK_LOCAL_CALLBACK_TIMEOUT_MS=300000

# Set the same token locally before starting the sidecar:
#   $env:PBK_LOCAL_TRIGGER_TOKEN="<same secret>"
#   npm run local:callback
# Then expose it with:
#   ngrok http 33517
PBK_LOCAL_TRIGGER_TOKEN=
# PBK_LOCAL_TRIGGER_HOST=127.0.0.1
# PBK_LOCAL_TRIGGER_PORT=33517
# PBK_LOCAL_TRIGGER_ALLOWED_ACTIONS=build,test:bridge,test:mcp,test:ui-actions

# ---------------------------------------------------------------------------
# NEON DISPOSABLE EVALUATION BRANCHES (OPTIONAL, EVAL-ONLY)
# Used by: npm run neon:evaluation
# ---------------------------------------------------------------------------

# These are only for temporary Neon branches used by Ava/agent evals and risky
# database checks before production. Production bridge state remains on Render
# Postgres through PBK_DATABASE_URL in Render.
#
# Never commit a real key. Store it in .env.local, Windows User env, or CI
# secrets. Prefer a project-scoped Neon API key.
NEON_API_KEY=
NEON_PROJECT_ID=
# PBK_NEON_API_KEY=             # alias accepted by the harness
# PBK_NEON_PROJECT_ID=          # alias accepted by the harness
# PBK_NEON_EVAL_PROJECT_ID=     # eval-specific project id alias
# NEON_PARENT_BRANCH_ID=
# PBK_NEON_EVAL_TTL_HOURS=24
# PBK_NEON_EVAL_BRANCH_NAME=
# PBK_NEON_EVAL_COMMAND=npm run test:ava-eval-suite
# PBK_NEON_EVAL_INJECT_RUNTIME_DB=false

# ---------------------------------------------------------------------------
# PUBLIC AVA CHAT
# Used by: public-ava-chat Netlify function
# ---------------------------------------------------------------------------

# REQUIRED — shared secret the public Ava chat function sends to the bridge.
# Without this, every /api/public/ava-chat request returns 503.
# Set in Netlify env vars as PUBLIC_AVA_CHAT_KEY (or the alias below).
PUBLIC_AVA_CHAT_KEY=
# PBK_PUBLIC_AVA_CHAT_KEY=

# ---------------------------------------------------------------------------
# CORS (OPTIONAL)
# Used by: pbk-bridge-proxy function, public-ava-chat function
# ---------------------------------------------------------------------------

# Comma-separated list of extra allowed origins beyond the built-in defaults.
# Defaults already include pbkcommandcenter.netlify.app and localhost variants.
# Example: https://app.yourdomain.com,https://staging.yourdomain.com
PBK_ALLOWED_ORIGINS=
# PBK_CORS_ALLOWED_ORIGINS=   # alias for PBK_ALLOWED_ORIGINS

# ---------------------------------------------------------------------------
# TUNING (OPTIONAL)
# ---------------------------------------------------------------------------

# Bridge proxy request timeout in milliseconds. Min 5000, max 25000. Default 20000.
# PBK_BRIDGE_PROXY_TIMEOUT_MS=20000

# Public Ava chat rate limit — max requests per IP per window. Default 60.
# PBK_PUBLIC_AVA_NETLIFY_RATE_LIMIT_MAX=60

# Public Ava chat rate limit window in milliseconds. Default 900000 (15 minutes).
# PBK_PUBLIC_AVA_NETLIFY_RATE_LIMIT_WINDOW_MS=900000
