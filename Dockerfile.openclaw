# PBK OpenClaw bridge — public host image (Render, Fly, etc.)
#
# The bridge needs:
#   - node 22+
#   - @sparticuz/chromium  (Chrome binary for serverless/container PDF rendering)
#   - puppeteer-core       (Puppeteer that talks to an external Chrome binary)
#   - pg                   (Postgres client for durable state when PBK_DATABASE_URL is set)
#   - @deepgram/sdk        (Deepgram transcription/sentiment bridge helpers)
#   - redis                (optional shared call state and singleton cron leases)
#
# Alpine + glibc-built chromium do not mix; use the Debian slim base so the
# Sparticuz Chromium binary can find its libc and X11 deps.

FROM node:22-slim AS frontend

WORKDIR /frontend

ENV PUPPETEER_SKIP_DOWNLOAD=true
ENV NPM_CONFIG_FETCH_RETRIES=5
ENV NPM_CONFIG_FETCH_RETRY_MINTIMEOUT=20000
ENV NPM_CONFIG_FETCH_RETRY_MAXTIMEOUT=120000

COPY package*.json ./
RUN if [ -f package-lock.json ]; then npm ci --legacy-peer-deps --ignore-scripts --no-audit --no-fund; else npm install --legacy-peer-deps --ignore-scripts --no-audit --no-fund; fi

COPY index.html ./index.html
COPY analyzer.html ./analyzer.html
COPY index.shell.html ./index.shell.html
COPY vite.config.ts ./vite.config.ts
COPY tsconfig.json ./tsconfig.json
COPY postcss.config.mjs ./postcss.config.mjs
COPY tailwind.pbk.config.ts ./tailwind.pbk.config.ts
COPY src ./src
COPY public ./public
RUN npm run build --ignore-scripts

FROM node:22-slim

# Runtime libraries Chrome needs. Sparticuz ships the binary, but the host
# image still needs the GTK/X11/font/SSL stack for it to launch.
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates \
      fonts-liberation \
      libasound2 \
      libatk-bridge2.0-0 \
      libatk1.0-0 \
      libc6 \
      libcairo2 \
      libcups2 \
      libdbus-1-3 \
      libexpat1 \
      libfontconfig1 \
      libgbm1 \
      libgcc-s1 \
      libglib2.0-0 \
      libgtk-3-0 \
      libnspr4 \
      libnss3 \
      libpango-1.0-0 \
      libpangocairo-1.0-0 \
      libstdc++6 \
      libx11-6 \
      libx11-xcb1 \
      libxcb1 \
      libxcomposite1 \
      libxcursor1 \
      libxdamage1 \
      libxext6 \
      libxfixes3 \
      libxi6 \
      libxrandr2 \
      libxrender1 \
      libxss1 \
      libxtst6 \
      bash \
      curl \
      ffmpeg \
      git \
      make \
      g++ \
      python3 \
      python3-venv \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# The bridge uses @sparticuz/chromium + puppeteer-core. Avoid accidental
# browser downloads during npm install in constrained hosted builders.
ENV PUPPETEER_SKIP_DOWNLOAD=true
ENV PUPPETEER_CACHE_DIR=/tmp/puppeteer
ENV PBK_HF_CACHE_DIR=/app/.cache/pbk-transformers
ENV NPM_CONFIG_FETCH_RETRIES=5
ENV NPM_CONFIG_FETCH_RETRY_MINTIMEOUT=20000
ENV NPM_CONFIG_FETCH_RETRY_MAXTIMEOUT=120000

# Install ONLY the bridge's runtime deps. The frontend's React/Radix universe
# in the repo's package.json is irrelevant to this container, so we don't ship it.
# Pinned versions for reproducibility.
RUN npm install --legacy-peer-deps --no-save --no-audit --no-fund --loglevel=warn --timeout=600000 \
      @sparticuz/chromium@147.0.1 \
      @deepgram/sdk@5.1.0 \
      @huggingface/transformers@4.2.0 \
      @langchain/langgraph@1.3.2 \
      @modelcontextprotocol/sdk@1.29.0 \
      @aws-sdk/client-s3@3.1056.0 \
      @aws-sdk/s3-request-presigner@3.1056.0 \
      @opentelemetry/api@1.9.1 \
      @opentelemetry/exporter-metrics-otlp-http@0.218.0 \
      @opentelemetry/exporter-trace-otlp-http@0.218.0 \
      @opentelemetry/instrumentation-express@0.66.0 \
      @opentelemetry/instrumentation-http@0.218.0 \
      @opentelemetry/sdk-metrics@2.7.1 \
      @opentelemetry/sdk-node@0.218.0 \
      puppeteer-core@24.41.0 \
      pg@8.13.1 \
      redis@5.10.0 \
      ws@8.20.1 \
      youtube-transcript@1.3.1

# Bake the compact q8 embedding model into the image. Render instances can
# restart without downloading model weights, which keeps Rex/Ava semantic
# memory independent of a runtime network call or provider quota.
RUN node --input-type=module -e "import { env, pipeline } from '@huggingface/transformers'; env.cacheDir=process.env.PBK_HF_CACHE_DIR; await pipeline('feature-extraction', 'Xenova/all-MiniLM-L6-v2', { dtype: 'q8' });"

# Property data import/scraping is intentionally isolated in a Python venv so
# the hosted bridge can run HomeHarvest and Scrapling without touching Node deps.
RUN python3 -m venv /app/.venv \
  && /app/.venv/bin/python -m pip install --upgrade --no-cache-dir pip \
  && /app/.venv/bin/python -m pip install --no-cache-dir \
      homeharvest==0.8.18 \
      'scrapling[fetchers]==0.4.7' \
      yt-dlp==2026.6.9 \
      'https://github.com/Panniantong/agent-reach/archive/refs/tags/v1.5.0.zip' \
  && /app/.venv/bin/scrapling install \
  && (timeout 90s /app/.venv/bin/agent-reach install --env=auto || true)

# Make Python-based operational tools discoverable by the Node bridge. This is
# what lets PBK_AGENT_REACH_COMMAND default to "agent-reach" in hosted Render.
ENV PATH="/app/.venv/bin:${PATH}"

# Copy the bridge source last so dependency installation caches across rebuilds.
COPY scripts/pbk-deepgram-client.mjs ./scripts/pbk-deepgram-client.mjs
COPY scripts/qa-agent.mjs ./scripts/qa-agent.mjs
COPY scripts/agent-registry.mjs ./scripts/agent-registry.mjs
COPY scripts/rex-autonomy.mjs ./scripts/rex-autonomy.mjs
COPY scripts/context-aware-script-rotator.mjs ./scripts/context-aware-script-rotator.mjs
COPY scripts/ava-governed-skill-router.mjs ./scripts/ava-governed-skill-router.mjs
COPY scripts/ava-emotional-script-library.mjs ./scripts/ava-emotional-script-library.mjs
COPY scripts/ava-live-skill-fallback.mjs ./scripts/ava-live-skill-fallback.mjs
COPY scripts/ava-live-turn-contract.mjs ./scripts/ava-live-turn-contract.mjs
COPY scripts/pbk-intelligence-context.mjs ./scripts/pbk-intelligence-context.mjs
COPY scripts/pbk-intelligence-context-runtime.mjs ./scripts/pbk-intelligence-context-runtime.mjs
COPY scripts/safety-validator.mjs ./scripts/safety-validator.mjs
COPY scripts/ava-eval-suite.mjs ./scripts/ava-eval-suite.mjs
COPY scripts/observability.mjs ./scripts/observability.mjs
COPY scripts/system-source-health.mjs ./scripts/system-source-health.mjs
COPY scripts/production-readiness-command-layer.mjs ./scripts/production-readiness-command-layer.mjs
COPY scripts/production-maturity-loop.mjs ./scripts/production-maturity-loop.mjs
COPY scripts/production-performance-hardening.mjs ./scripts/production-performance-hardening.mjs
COPY scripts/connection-strength-check.mjs ./scripts/connection-strength-check.mjs
COPY scripts/production-gap-labels.mjs ./scripts/production-gap-labels.mjs
COPY scripts/primary-path-reliability.mjs ./scripts/primary-path-reliability.mjs
COPY scripts/ava-latency-status.mjs ./scripts/ava-latency-status.mjs
COPY scripts/coworker-heartbeat.mjs ./scripts/coworker-heartbeat.mjs
COPY scripts/slack-mention-router.mjs ./scripts/slack-mention-router.mjs
COPY scripts/youtube-training.mjs ./scripts/youtube-training.mjs
COPY scripts/ava-assistant-chat.mjs ./scripts/ava-assistant-chat.mjs
COPY scripts/lead-raw-proof-job.mjs ./scripts/lead-raw-proof-job.mjs
COPY scripts/lead-field-provenance.mjs ./scripts/lead-field-provenance.mjs
COPY scripts/deepspec-speculative-client.mjs ./scripts/deepspec-speculative-client.mjs
COPY scripts/ava-mission-controller.mjs ./scripts/ava-mission-controller.mjs
COPY scripts/ava-state-machine.mjs ./scripts/ava-state-machine.mjs
COPY scripts/ava-confidence.mjs ./scripts/ava-confidence.mjs
COPY scripts/ava-working-memory.mjs ./scripts/ava-working-memory.mjs
COPY scripts/ava-response-guard.mjs ./scripts/ava-response-guard.mjs
COPY scripts/ava-action-decision-policy.mjs ./scripts/ava-action-decision-policy.mjs
COPY scripts/ava-turn-orchestrator.mjs ./scripts/ava-turn-orchestrator.mjs
COPY scripts/negotiation-policy.mjs ./scripts/negotiation-policy.mjs
COPY scripts/question-policy.mjs ./scripts/question-policy.mjs
COPY scripts/closing-questions.mjs ./scripts/closing-questions.mjs
COPY scripts/emotion-policy.mjs ./scripts/emotion-policy.mjs
COPY scripts/warmth-dominance.mjs ./scripts/warmth-dominance.mjs
COPY scripts/synthetic-edge-cases.mjs ./scripts/synthetic-edge-cases.mjs
COPY scripts/mission-resilience.mjs ./scripts/mission-resilience.mjs
COPY scripts/agent-teams.mjs ./scripts/agent-teams.mjs
COPY scripts/auto-skill-learner.mjs ./scripts/auto-skill-learner.mjs
COPY scripts/nurture-agent.mjs ./scripts/nurture-agent.mjs
COPY scripts/onnx-training-worker.mjs ./scripts/onnx-training-worker.mjs
COPY scripts/research-additives.mjs ./scripts/research-additives.mjs
COPY scripts/rex-research-memory.mjs ./scripts/rex-research-memory.mjs
COPY scripts/vector-embedding.mjs ./scripts/vector-embedding.mjs
COPY scripts/skill-governance-schema.mjs ./scripts/skill-governance-schema.mjs
COPY scripts/skill-governance-store.mjs ./scripts/skill-governance-store.mjs
COPY scripts/skill-runtime-snapshot.mjs ./scripts/skill-runtime-snapshot.mjs
COPY scripts/skill-youtube-ingest.mjs ./scripts/skill-youtube-ingest.mjs
COPY scripts/docusign-webhook-auth.mjs ./scripts/docusign-webhook-auth.mjs
COPY scripts/command-intent-router.mjs ./scripts/command-intent-router.mjs
COPY scripts/ava-intent-router.mjs ./scripts/ava-intent-router.mjs
COPY scripts/ava-coaching-memory.mjs ./scripts/ava-coaching-memory.mjs
COPY scripts/ava-episodic-memory.mjs ./scripts/ava-episodic-memory.mjs
COPY scripts/train-emotion-world-model.mjs ./scripts/train-emotion-world-model.mjs
COPY scripts/train_emotion_world_model_onnx.py ./scripts/train_emotion_world_model_onnx.py
COPY scripts/conversation-identity.mjs ./scripts/conversation-identity.mjs
COPY scripts/conversation-projector.mjs ./scripts/conversation-projector.mjs
COPY scripts/conversation-live-projector.mjs ./scripts/conversation-live-projector.mjs
COPY scripts/conversation-schema.mjs ./scripts/conversation-schema.mjs
COPY scripts/conversation-store.mjs ./scripts/conversation-store.mjs
COPY scripts/backfill-conversations.mjs ./scripts/backfill-conversations.mjs
COPY scripts/provider-action-dispatch-policy.mjs ./scripts/provider-action-dispatch-policy.mjs
COPY scripts/provider-action-dispatch.mjs ./scripts/provider-action-dispatch.mjs
COPY scripts/provider-proof-ledger.mjs ./scripts/provider-proof-ledger.mjs
COPY scripts/invoke-rate-limit.mjs ./scripts/invoke-rate-limit.mjs
COPY scripts/event-bus ./scripts/event-bus
COPY scripts/property-data-adapter.mjs ./scripts/property-data-adapter.mjs
COPY scripts/openclaw-local-server.mjs ./scripts/openclaw-local-server.mjs
COPY --from=frontend /frontend/dist/index.html ./index.html
COPY --from=frontend /frontend/dist/analyzer.html ./analyzer.html
COPY --from=frontend /frontend/dist/index.shell.html ./index.shell.html
COPY --from=frontend /frontend/dist/assets ./assets
COPY public ./public
COPY contracts ./contracts
COPY wholesale.agent.md ./wholesale.agent.md

# Advanced tooling status assets. These are read-only manifests/configs used by
# /api/tooling/status so hosted production reflects the same readiness as local.
COPY labs/meta-agent/generated ./labs/meta-agent/generated
COPY ops/browser-research ./ops/browser-research
COPY ops/upgrade-integrations ./ops/upgrade-integrations
COPY ops/monitoring ./ops/monitoring
COPY mcp-servers ./mcp-servers
COPY n8n-lite/tooling-health-check.json ./n8n-lite/tooling-health-check.json
COPY .github/workflows/tooling-verify.yml ./.github/workflows/tooling-verify.yml

# Default to the persistent state path for file-mode fallback. When
# PBK_DATABASE_URL is set the bridge ignores this and uses Postgres instead.
ENV NODE_ENV=production
ENV PBK_OPENCLAW_STATE_DIR=/app/.pbk-local

# Render injects $PORT at runtime — the bridge already reads it. 10000 is the
# default fallback when nothing is injected.
ENV PORT=10000
EXPOSE 10000

# `--public` bumps the bridge into hosted mode (binds 0.0.0.0, hardens defaults).
CMD ["node", "./scripts/openclaw-local-server.mjs", "--public"]
