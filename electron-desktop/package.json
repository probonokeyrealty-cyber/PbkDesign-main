{
  "name": "pbk-ava-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "PBK Ava desktop wrapper with tray and hotkey access to the live dashboard voice interface.",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.probonokeyrealty.ava",
    "productName": "PBK Ava Desktop",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "sidecar-core.js",
      "preload.js",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false,
      "signDlls": false
    },
    "mac": {
      "target": "dmg"
    }
  }
}
